@page "/tiere"
@inject AnimalSearchService Search
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="Vermittelbare Tiere aus Tierheimen und Tierschutzorganisationen durchsuchen und filtern." />
    @if (SearchQuery.HasFiltersBeyondSpecies(Criteria))
    {
        <meta name="robots" content="noindex,follow" />
    }
    else
    {
        <link rel="canonical" href="@Canonical" />
    }
</HeadContent>

<h1>Tiere suchen</h1>

<form method="get" class="filters">
    <div class="filter-grid">
        <label>
            Suche
            <input type="search" name="q" value="@Criteria.Text" maxlength="@SearchQuery.MaxTextLength" placeholder="Name, Rasse oder Beschreibung" />
        </label>
        <label>
            Tierart
            <select name="art">
                <option value="">Alle</option>
                @foreach (var s in Enum.GetValues<Species>())
                {
                    <option value="@s" selected="@(Criteria.Species == s)">@s</option>
                }
            </select>
        </label>
        <label>
            Geschlecht
            <select name="geschlecht">
                <option value="">Egal</option>
                @foreach (var o in SearchQuery.SexOptions)
                {
                    <option value="@o.Token" selected="@(SearchQuery.SexToken(Criteria.Sex) == o.Token)">@o.Label</option>
                }
            </select>
        </label>
        <label>
            Größe
            <select name="groesse">
                <option value="">Egal</option>
                @foreach (var o in SearchQuery.SizeOptions)
                {
                    <option value="@o.Token" selected="@(SearchQuery.SizeToken(Criteria.Size) == o.Token)">@o.Label</option>
                }
            </select>
        </label>
        <label>
            Alter
            <select name="alter">
                <option value="">Egal</option>
                @foreach (var o in SearchQuery.AgeOptions)
                {
                    <option value="@o.Token" selected="@(SearchQuery.AgeToken(Criteria.AgeGroup) == o.Token)">@o.Label</option>
                }
            </select>
        </label>
        <label>
            Sortierung
            <select name="sort">
                @foreach (var o in SearchQuery.SortOptions)
                {
                    <option value="@o.Token" selected="@((SearchQuery.SortToken(Criteria.Sort) ?? "") == o.Token)">@o.Label</option>
                }
            </select>
        </label>
    </div>

    <div class="checks">
        <label><input type="checkbox" name="kastriert" value="1" checked="@Criteria.NeuteredOnly" /> Kastriert</label>
        <label><input type="checkbox" name="kinder" value="1" checked="@Criteria.GoodWithChildren" /> Kinderfreundlich</label>
        <label><input type="checkbox" name="hunde" value="1" checked="@Criteria.GoodWithDogs" /> Verträgt sich mit Hunden</label>
        <label><input type="checkbox" name="katzen" value="1" checked="@Criteria.GoodWithCats" /> Verträgt sich mit Katzen</label>
        <label><input type="checkbox" name="wohnung" value="1" checked="@Criteria.SuitableForApartment" /> Für Wohnung geeignet</label>
        <label><input type="checkbox" name="dringend" value="1" checked="@Criteria.UrgentOnly" /> Nur dringende Fälle</label>
    </div>

    <div class="filters-actions">
        <button type="submit">Suchen</button>
        @if (Criteria.Species is not null || SearchQuery.HasFiltersBeyondSpecies(Criteria))
        {
            <a class="reset" href="/tiere">Filter zurücksetzen</a>
        }
    </div>
</form>

<p class="count">@Result.Total @(Result.Total == 1 ? "Tier" : "Tiere") gefunden</p>

@if (Result.Items.Count == 0)
{
    <p>Keine Tiere gefunden. Versuche es mit anderen Filtern.</p>
}
else
{
    <div class="grid">
        @foreach (var a in Result.Items)
        {
            <a class="card" href="/tiere/@a.Slug">
                <div class="card-img">
                    @if (a.ImageUrl is not null)
                    {
                        <img src="@a.ImageUrl" alt="@a.Name" loading="lazy" referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <span class="placeholder">@AnimalDisplay.SpeciesEmoji(a.Species)</span>
                    }
                    @if (a.IsUrgent)
                    {
                        <span class="badge">Dringend</span>
                    }
                </div>
                <div class="card-body">
                    <h2>@a.Name</h2>
                    <p>@a.Species@(a.Breed is null ? "" : " · " + a.Breed) · @AnimalDisplay.AgeText(a.BirthDate, a.ApproxAgeMonths)</p>
                    <p class="muted">@a.OrganizationName@(string.IsNullOrWhiteSpace(a.City) ? "" : ", " + a.City)</p>
                </div>
            </a>
        }
    </div>

    @if (Result.PageCount > 1)
    {
        <nav class="paging" aria-label="Seiten">
            @if (Result.Page > 1)
            {
                <a href="@PageUrl(Result.Page - 1)">← Zurück</a>
            }
            <span>Seite @Result.Page von @Result.PageCount</span>
            @if (Result.Page < Result.PageCount)
            {
                <a href="@PageUrl(Result.Page + 1)">Weiter →</a>
            }
        </nav>
    }
}

@code {
    private const int PageSize = 12;

    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "art")] private string? Art { get; set; }
    [SupplyParameterFromQuery(Name = "geschlecht")] private string? Geschlecht { get; set; }
    [SupplyParameterFromQuery(Name = "groesse")] private string? Groesse { get; set; }
    [SupplyParameterFromQuery(Name = "alter")] private string? Alter { get; set; }
    [SupplyParameterFromQuery(Name = "kastriert")] private string? Kastriert { get; set; }
    [SupplyParameterFromQuery(Name = "kinder")] private string? Kinder { get; set; }
    [SupplyParameterFromQuery(Name = "hunde")] private string? Hunde { get; set; }
    [SupplyParameterFromQuery(Name = "katzen")] private string? Katzen { get; set; }
    [SupplyParameterFromQuery(Name = "wohnung")] private string? Wohnung { get; set; }
    [SupplyParameterFromQuery(Name = "dringend")] private string? Dringend { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] private string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "seite")] private int Seite { get; set; } = 1;

    private AnimalSearchCriteria Criteria { get; set; } = new();
    private AnimalSearchResult Result { get; set; } = AnimalSearchResult.Empty;

    private string Title => Criteria.Species is { } species
        ? $"{species} suchen – Tierschutz Collect"
        : "Tiere suchen – Tierschutz Collect";

    protected override async Task OnInitializedAsync()
    {
        Criteria = SearchQuery.Parse(Q, Art, Geschlecht, Groesse, Alter, Kastriert, Kinder, Hunde, Katzen, Wohnung, Dringend, Sort);
        Result = await Search.SearchAsync(Criteria, Seite, PageSize);
    }

    private string PageUrl(int page) => "/tiere" + SearchQuery.ToQueryString(Criteria, page);

    // Canonical URL for indexable pages (list or species page, optionally with page number)
    private string Canonical => SiteUrls.Combine(
        SiteUrls.Base(Config["Site:BaseUrl"], Nav.BaseUri),
        "tiere" + SearchQuery.ToQueryString(Criteria, Result.Page));
}
